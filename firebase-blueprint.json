{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "barcode": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "sellPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "active": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "sellPrice", "stockQuantity"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "outstandingBalance": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" },
        "customerId": { "type": "string" }
      },
      "required": ["id", "orderNumber", "grandTotal", "paymentMethod", "createdAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "description": "System user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "pin": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "role", "pin"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global products collection"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Global categories collection"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Global customers collection"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Global sales history"
    },
    "/settings/store_config": {
      "schema": "Settings",
      "description": "Global store settings"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Global users collection"
    }
  }
}
